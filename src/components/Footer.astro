---
import Logo from './Logo.astro';
import settings from '../data/settings.json';

const year = new Date().getFullYear();
const a = settings.address;
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="col about">
      <Logo size={44} markOnly />
      <p class="name">{settings.labFullName}</p>
      <p class="body">
        {settings.institution}.<br />
        Directed by <a href="/people/">Prof. {settings.directorName}</a>.
      </p>
    </div>

    <div class="col">
      <h2>Lab</h2>
      <a href="/research/">Research</a>
      <a href="/publications/">Publications</a>
      <a href="/people/">People</a>
      <a href="/projects/">Projects</a>
      <a href="/people/alumni/">Alumni</a>
      <a href="/news/">News</a>
    </div>

    <div class="col">
      <h2>Connect</h2>
      <a href="/join/">Join the lab</a>
      <a href="/contact/">Contact &amp; visiting</a>
      <a href="/news/rss.xml">News RSS</a>
      <a href={settings.links.faculty}>Faculty of Information</a>
    </div>

    <div class="col">
      <h2>Find us</h2>
      <p class="body">
        {a.line1}<br />{a.line2}<br />{a.line3}<br />{a.line4}
      </p>
    </div>
  </div>

  <div class="wrap base">
    <span>© {year} {settings.labName}, University of Toronto</span>
    <span class="dot" aria-hidden="true">·</span>
    <span>Built with Astro. <a href={settings.links.repo}>Source on GitHub</a></span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 3px solid var(--yellow);
    background: var(--surface);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
    padding-bottom: var(--s-4);
  }
  @media (min-width: 640px) { .inner { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .inner { grid-template-columns: 1.6fr 1fr 1fr 1.1fr; gap: var(--s-4); } }

  .col { display: flex; flex-direction: column; gap: 7px; align-items: flex-start; }

  .col h2 {
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 3px;
  }

  .col a { font-size: var(--t-small); color: var(--ink-2); text-decoration: none; }
  .col a:hover { color: var(--blue-ink); text-decoration: underline; }

  .about { gap: 10px; }
  .about .name {
    font-family: var(--f-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    max-width: 24ch;
    line-height: 1.25;
  }
  .body { font-size: var(--t-small); color: var(--ink-2); line-height: 1.6; }
  .body a { text-decoration: underline; }

  .base {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-2);
    padding-bottom: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--f-mono);
    font-size: var(--t-meta);
    color: var(--ink-3);
  }
  .base a { color: var(--ink-3); }
  .dot { opacity: .5; }
</style>
